import os
from pathlib import Path
import pandas as pd

configfile: "../config/config.json"

with open("SRR_id.txt") as f:
    id_list = f.read().splitlines()

with open("SRR_id_fxs.txt") as f:
    id_fxs_list = f.read().splitlines()

with open("SRR_id_control.txt") as f:
    id_control_list = f.read().splitlines()

df = pd.read_csv('data/comparisons.tsv', sep='\t')

comp_list = [f"{cdn1}-{cdn2}" for cdn1, cdn2 in zip(df['cdn1'], df['cdn2'])]
comp_str = ''.join(map(str, comp_list))
comp_str = comp_str.replace(' ', '', 1)
comp_str = comp_str.replace(' - ', '-')
comp_str = comp_str.replace(' ', '', 1)
comparisons = comp_str

df_cond = pd.read_csv('data/design.tsv', sep='\t', usecols=['sample','condition'])
conditions = df_cond['condition'].unique().tolist()

include: "rules/I_download.smk"
include: "rules/II_fastq.smk"
include: "rules/III_preprocess.smk"
include: "rules/IV_align_star.smk"
include: "rules/Va_quant_kallisto.smk"
include: "rules/Vb_quant_coco.smk"
include: "rules/VIa_dge_kallisto.smk"
include: "rules/VIb_dge_coco.smk"
include: "rules/VIc_dge_kallisto_vs_coco.smk"
include: "rules/VII_splicing.smk"
include: "rules/VIIIa_transcriptome_kallisto.smk"
include: "rules/VIIIb_transcriptome_coco.smk"


####################################### LOCAL ########################################
rule I_download:                                                                     #
    input:                                                                           #
        download_human_genome = "data/references/genome_fa/homo_sapiens_genome.fa",  #
        clone_coco = 'git_repos/coco',                                               #
        tx2gene = "data/references/tx2gene.tsv" ,                                    #
        build_tx2gene_all = "data/references/tx2gene_all.tsv",                       #                                                                                 #
                                                                                     #
rule II_fastq:                                                                       #
    input:                                                                           #
        fastq_download = "data/references/download_fastq.done",                      #
        rename_fastq = "data/references/rename_fastq.done"                           #
######################################################################################


rule III_preprocess:
    input:
        qc_pre_trim = expand("results/qc/pre_trim/{id}_1_fastqc.html", id=id_list),
        fastp_trim = expand("results/preprocess/fastp/{id}_1_trimmed.fastq.gz", id=id_list),
        qc_post_trim = expand("results/qc/post_trim/{id}_1_trimmed_fastqc.html", id=id_list)

rule IV_align_star:
    input:
        star_index = config["path"]["chrNameLength"],
        star_alignReads = expand("results/alignment/star/{id}/Aligned.sortedByCoord.out.bam", id=id_list)


########################################## DGE kallisto #######################################################
rule Va_quant_kallisto:
    input:
        build_transcriptome = config["path"]["transcriptome"],
        build_kallisto_index = "data/references/kallisto.idx",
        quant_kallisto = expand("results/quant/kallisto/{id}/abundance.tsv", id = id_list)

rule VIa_dge_kallisto:
    input:
        filter_protein_coding_gtf = "data/references/gtf/Homo_sapiens.GRCh38.110_protein_coding.gtf",
        build_tx2gene_pc = "data/references/tx2gene_protein_coding.tsv",
        dge_kallisto_protein_coding = expand('results/dge/kallisto_protein_coding/{comp}_DESeq2_gene.csv', comp = comparisons),
        dge_kallisto_protein_coding_stats = expand("results/dge/kallisto_protein_coding/{comp}_deseq2_stats.csv", comp=comparisons)


########################################## DGE Coco ############################################################
rule Vb_quant_coco:
    input:
        coco_correct_annotation = "data/references/gtf/Homo_sapiens.GRCh38.110_snoRNAs_tRNAs_correct_annotation.gtf",
        coco_quant = expand("results/quant/coco/{id}.tsv", id = id_list),
        merge_coco_cc = "results/quant/coco_merged_counts.tsv"

rule VIb_dge_coco:
    input:
        filter_protein_coding_gtf_coco = "data/references/gtf/Homo_sapiens.GRCh38.110_snoRNAs_tRNAs_correct_annotation_protein_coding.gtf",
        build_tx2gene_pc_coco = "data/references/tx2gene_protein_coding_coco.tsv",
        dge_coco_protein_coding = expand('results/dge/coco_protein_coding/{comp}_DESeq2_gene.csv', comp = comparisons),
        dge_coco_protein_coding_stats = expand("results/dge/coco_protein_coding/{comp}_deseq2_stats.csv", comp=comparisons),
        dge_go_enrichment = expand("results/dge/coco_protein_coding/go/total/{comp}_go_enrichment_total.csv", comp = comparisons),
        dge_kegg_enrichment = expand("results/dge/coco_protein_coding/kegg/total/{comp}_kegg_enrichment_total.csv", comp = comparisons),
        dge_reactome_enrichment = expand("results/dge/coco_protein_coding/reactome/total/{comp}_reactome_enrichment_total.csv", comp = comparisons),
        dge_ma_plot = expand("results/dge/coco_protein_coding/{comp}_MAplot.png", comp = comparisons),
        dge_heatmap_degs = expand("results/dge/coco_protein_coding/heatmap/{comp}_heatmap_topDEG.png", comp = comparisons),
        dge_pca_plot = expand("results/dge/coco_protein_coding/{comp}_PCAplot.png", comp = comparisons),
        dge_tsne_plot = expand("results/dge/coco_protein_coding/{comp}_tSNEplot.png", comp = comparisons)


########################################## DGE kallisto vs Coco ############################################################
rule VIc_dge_kallisto_vs_coco:
    input:
        deseq2_protein_coding_kallisto_vs_coco = expand("results/dge/kallisto_vs_coco/deseq2_protein_coding_kallisto_vs_coco_{comp}.csv", comp = comparisons)

########################################## Splicing ############################################################
rule VII_splicing:
    input:
        extract_primary_alignments= expand("results/splicing/star/{id}/{id}_Aligned.sortedByCoord.out.primary.bam", id = id_list),
        index_primary_bam = expand("results/splicing/star/{id}/{id}_Aligned.sortedByCoord.out.primary.bam.bai", id = id_list),
        coverage_bedgraph = expand("results/splicing/genomecov/{id}.bedgraph", id = id_list),
        make_split_script = "scripts/split_bams_by_cond.sh",
        run_split_script = "results/splicing/star/split_bam_done.txt",
        list_bams_for_rmats = "results/splicing/rmats/fxs_bam_list.txt",
        merge_kallisto_tpm = "results/quant/kallisto_merged_tpm.tsv",
        rmats_original = expand("results/splicing/rmats/{comp}/raw/summary.txt", comp = comparisons),
        rmats_coco = expand("results/splicing/rmats_coco/{comp}/raw/summary.txt", comp = comparisons),
        filter_rmats_original = expand("results/splicing/rmats/{comp}/filtered/SE.tsv", comp = comparisons),
        filter_rmats_coco = expand("results/splicing/rmats_coco/{comp}/filtered/SE.tsv", comp = comparisons)


########################################## DGE transcriptome kallisto ############################################################
rule VIIIa_transcriptome_kallisto:
    input:
        transcriptome_deseq2_kallisto= expand("results/transcriptome/kallisto/deseq2/{comp}_DESeq2_transcripts.csv", comp = comparisons),
        transcriptome_stats_kallisto = expand("results/transcriptome/kallisto/deseq2/{comp}_transcriptome_stats.csv", comp = comparisons),
        gene_deseq2_kallisto = expand("results/transcriptome/kallisto/deseq2/gene/{comp}_DESeq2_genes.csv", comp = comparisons),
        gene_stats_kallisto = expand("results/transcriptome/kallisto/deseq2/gene/{comp}_gene_stats.csv", comp = comparisons)


########################################## DGE transcriptome coco ############################################################
rule VIIIb_transcriptome_coco:
    input:
        transcriptome_deseq2_coco = expand("results/transcriptome/coco/deseq2/{comp}_DESeq2_transcripts.csv", comp = comparisons),
        transcriptome_stats_coco = expand("results/transcriptome/coco/deseq2/{comp}_transcriptome_stats.csv", comp = comparisons)